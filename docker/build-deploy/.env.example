# -----------------------------------------------
# Copy this file to .env and fill in your values
# -----------------------------------------------

# PostgreSQL
POSTGRES_DB=property_booking
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-in-production

# Backend
JWT_SECRET=change-me-in-production
NODE_ENV=production

# CORS — the URL the browser uses to reach the frontend
FRONTEND_URL=http://localhost:3000

# API URL baked into the React build. nginx.conf already proxies /api/ to
# the backend on the same origin, so this should stay a relative path —
# NOT an absolute http://localhost:... URL, which only works on the machine
# actually running the backend, not on a visitor's browser.
REACT_APP_API_URL=/api

# Optional — email/SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
